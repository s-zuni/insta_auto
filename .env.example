# ============================================================
# insta_auto — 환경변수 템플릿
# 복사: cp .env.example .env   (루트의 .env 하나를 Agent가 읽습니다)
# Web 전용 값은 apps/web/.env.local 에 둡니다 (start_local 스크립트가 자동 생성)
# ============================================================

# ---------- [Web] apps/web/.env.local ----------
# demo  = Vercel 데모(목 데이터, 실제 업로드 없음)
# local = 고객 PC (로컬 Agent 호출)
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- [Agent] 런타임 ----------
APP_MODE=local                 # local | demo
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_OUTPUT_DIR=apps/agent/output

# ---------- [License] (고객 PC) ----------
LICENSE_ENFORCE=false          # 판매 빌드에서는 true
LICENSE_KEY=
LICENSE_PUBLIC_KEY=            # Ed25519 공개키(base64, raw 32 bytes). 비밀키는 절대 배포 금지
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # 서버/운영 전용. 고객 배포본에는 넣지 않기

# ---------- [AI] ----------
ANTHROPIC_API_KEY=             # 비어 있으면 Mock 콘텐츠로 동작
AI_MODEL=claude-sonnet-5-5
TTS_VOICE=ko-KR-SunHiNeural    # edge-tts 한국어 음성
IMAGE_PROVIDER=none            # none | (추후) replicate | openai

# ---------- [Instagram Reels · Meta Graph API] ----------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# ---------- [YouTube Shorts · Data API v3] ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private             # 테스트는 private 권장 (public | unlisted | private)

# ---------- [Threads Official API] ----------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ---------- [Naver Blog · Playwright] ----------
NAVER_BLOG_ID=
NAVER_PROFILE_DIR=apps/agent/.browser_profile   # 로컬 크롬 세션 유지 폴더 (커밋 금지)
NAVER_HEADLESS=false

# ---------- [Team 자동화 · 하네스] ----------
SLACK_WEBHOOK_URL=             # GitHub Actions secret 으로도 등록
NOTION_TOKEN=                  # Notion MCP를 쓰면 불필요
NOTION_SPEC_DB_ID=
