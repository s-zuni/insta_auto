# Google Gemini API Key (google-genai SDK용, AI Studio 모드로 우선 사용됨)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud & Vertex AI 설정 (Imagen 3 및 Cloud TTS용)
# GOOGLE_APPLICATION_CREDENTIALS는 Vertex AI Imagen / Cloud TTS 서비스 계정 용도입니다.
# Google Drive 업로드는 더 이상 이 서비스 계정을 사용하지 않습니다 (개인 Gmail 드라이브는
# 서비스 계정 저장 용량이 0바이트라 업로드가 항상 실패합니다). 아래 OAuth 설정을 사용하세요.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service_account_key.json
GCP_LOCATION=us-central1
# USE_VERTEX_GEMINI=true 로 설정하면 GEMINI_API_KEY 대신 Vertex AI로 대본을 생성합니다.
# (Vertex AI API가 해당 GCP 프로젝트에서 활성화되어 있어야 합니다)
USE_VERTEX_GEMINI=false

# 모델 설정
GEMINI_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002

# TTS 설정
TTS_VOICE_NAME=ko-KR-Neural2-C
TTS_SPEAKING_RATE=1.05

# 텔레그램 설정
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 인스타그램 설정
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token

# 구글 드라이브 설정 (OAuth 사용자 인증, 'python pipeline/gdrive_oauth_setup.py' 로 발급)
# 로컬 개발: token.json 파일이 자동 생성되어 사용됩니다 (GOOGLE_OAUTH_TOKEN_PATH로 경로 지정 가능).
# Railway 등 배포 환경: token.json의 전체 JSON 내용을 아래 변수에 그대로 등록하세요.
GOOGLE_OAUTH_TOKEN_JSON=
GDRIVE_FOLDER_ID=your_google_drive_folder_id
